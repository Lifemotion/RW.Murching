<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bwl.Murching</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Local subtitling and dubbing engine: media probing, VAD, Whisper ASR, subtitle generation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bwl.Murching.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" />
    <PackageReference Include="ElBruno.QwenTTS" />
    <PackageReference Include="ElBruno.QwenTTS.VoiceCloning" />
    <!-- The CPU-only onnxruntime.dll from the transitive dependency would clash with the DirectML build (which also contains the CPU provider). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
